digraph { rankdir=LR; graph [bgcolor="white", fontname="DejaVu Sans", pad=0.4, nodesep=0.5, ranksep=0.7, splines=true];
node [shape=box, style="filled,rounded", fontname="DejaVu Sans", fontsize=13, color="#333333", penwidth=1.6, margin="0.22,0.14"];
edge [fontname="DejaVu Sans", fontsize=11, color="#444444", penwidth=1.5, fontcolor="#222222"]; labelloc=t; label="01 · System overview: who talks to what"; fontsize=18;
 subgraph cluster_pond { label="POND (works with no internet)"; style="dashed,rounded"; color="#c4600a"; fontcolor="#c4600a";
  sens [label="Sensors\nDO, temp, pH, salinity", fillcolor="#ffd9b0", color="#c4600a"]; esp [label="ESP32 node\ntwo-tier DO control", fillcolor="#ffd9b0", color="#c4600a"]; aer [label="Aerator relay\nfails ON, manual bypass", fillcolor="#ffd9b0", color="#c4600a"]; sens->esp->aer; }
 subgraph cluster_people { label="PEOPLE"; style="dashed,rounded"; color="#2e8b3e"; fontcolor="#2e8b3e";
  farm [label="Farmer app\nFlutter, offline-first", fillcolor="#c8f0c8", color="#2e8b3e"]; tech [label="Technician mode", fillcolor="#c8f0c8", color="#2e8b3e"]; web [label="Exporter portal +\nAdmin console (Next.js)", fillcolor="#ecd0f7", color="#8a2bb0"]; }
 subgraph cluster_cloud { label="CLOUD"; style="dashed,rounded"; color="#1c6fc2"; fontcolor="#1c6fc2";
  mqtt [label="MQTT broker (TLS)", fillcolor="#e6e6e6", color="#666666"]; api [label="FastAPI API", fillcolor="#bfe0ff", color="#1c6fc2"]; core [label="Backend core\n(see diagram 02)", fillcolor="#bfe0ff", color="#1c6fc2"]; mqtt->core; api->core; }
 esp -> mqtt [label="readings, alerts  ", color="#c4600a", fontcolor="#c4600a"];
 farm -> api [label="HTTPS + offline sync", color="#2e8b3e", fontcolor="#2e8b3e"];
 tech -> api [color="#2e8b3e"];
 web -> api [label="HTTPS", color="#8a2bb0", fontcolor="#8a2bb0"];
}

digraph { rankdir=TB; graph [bgcolor="white", fontname="DejaVu Sans", pad=0.4, nodesep=0.5, ranksep=0.7, splines=true];
node [shape=box, style="filled,rounded", fontname="DejaVu Sans", fontsize=13, color="#333333", penwidth=1.6, margin="0.22,0.14"];
edge [fontname="DejaVu Sans", fontsize=11, color="#444444", penwidth=1.5, fontcolor="#222222"]; labelloc=t; label="02 · Backend core: events in, signed passport out"; fontsize=18;
 inp [label="Incoming events\nfrom MQTT and API", fillcolor="#e6e6e6", color="#666666"];
 es [label="Event store\nappend-only, hash chains", fillcolor="#bfe0ff", color="#1c6fc2"]; re [label="Rule engine\nversioned rule packs", fillcolor="#bfe0ff", color="#1c6fc2"];
 gate [label="Harvest gate\nCLEARED / BLOCKED / REVIEW REQUIRED", fillcolor="#fff3b0", color="#b8960c"]; pass [label="Passport + signing", fillcolor="#bfe0ff", color="#1c6fc2"]; con [label="Consent + access control", fillcolor="#bfe0ff", color="#1c6fc2"];
 out [label="Exporter views a\nconsent-scoped passport", fillcolor="#ecd0f7", color="#8a2bb0"];
 ai [label="AI services (advisory only)\nOCR, triage, forecast", fillcolor="#c8f0c8", color="#2e8b3e"];
 pg [label="Postgres + TimescaleDB\nevents, projections", fillcolor="#e6e6e6", color="#666666"]; s3 [label="S3 / MinIO\nphotos, lab reports", fillcolor="#e6e6e6", color="#666666"]; kms [label="KMS\nsigning + data keys", fillcolor="#e6e6e6", color="#666666"]; ts [label="External timestamp\nperiodic Merkle root", fillcolor="#e6e6e6", color="#666666"];
 inp->es->re->gate->pass->out; con->pass;
 es->pg; es->s3; pass->kms; es->ts [style=dashed, label="anchor"];
 ai->inp [style=dashed, label="suggestions only,\nnever decisions", color="#2e8b3e", fontcolor="#2e8b3e"];
}
